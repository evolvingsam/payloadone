# Paystack
PAYSTACK_SECRET_KEY=sk_live_your_key_here

# Flutterwave
FLUTTERWAVE_SECRET_HASH=FLWSECK_TEST-your_hash_here

# Idempotency backend: "redis" or "postgres"
IDEMPOTENCY_BACKEND=redis

# Redis (required if IDEMPOTENCY_BACKEND=redis)
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (required if IDEMPOTENCY_BACKEND=postgres)
POSTGRES_DSN=postgresql://user:password@localhost:5432/yourdb

# TTL for processed references (seconds, default 86400 = 24h)
IDEMPOTENCY_TTL_SECONDS=86400